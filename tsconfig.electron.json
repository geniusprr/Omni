{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-electron",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node", "electron"]
  },
  "include": [
    "electron/**/*.ts",
    "electron/**/*.cts",
    "shared/**/*.ts",
    "src/types.ts"
  ]
}
