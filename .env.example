VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_DEVICE_ID=YOUR_DEVICE_UUID

# Recommended for production: a rate-limited Supabase Edge Function or other
# server-side proxy that exposes YouTube Data API v3 search/videos operations.
# Do not put a server secret in the frontend bundle.
VITE_YOUTUBE_DATA_API_PROXY_URL=

# Optional development fallback only. Restrict this Google API key by API,
# application and quota; frontend Vite variables are visible to desktop users.
VITE_YOUTUBE_DATA_API_KEY=
