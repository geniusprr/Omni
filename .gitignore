node_modules/
dist/
dist-electron/
release/
release*/
*.log
*.tsbuildinfo
.env
.env.*
!.env.example
.supabase
supabase/.temp

# Generated vendor build cache/staging.
vendor/.cache
vendor/.runtime-*

# LibreChat is bundled as a prebuilt static distribution. Keep transient
# vendor staging ignored, but version the exact client shipped in releases so
# GitHub Actions can reproduce the same complete installer as local builds.
vendor/*
!vendor/librechat-client/
!vendor/librechat-client/**

# Installer/package outputs are local release artifacts, not source files.
*.exe
*.blockmap
*.nsis.7z
*.dmg
*.AppImage

# IDE & OS
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
