.env
.env.*
!.env.example
.supabase
supabase/.temp

# Generated vendor build cache/staging.
vendor/.cache
vendor/.runtime-*

# LibreChat is bundled as a local, prebuilt static distribution for the
# Electron package. It is regenerated/staged locally and is not application
# source; keeping it ignored prevents its hundreds of hashed assets and
# compressed copies from flooding the working tree.
vendor/

# Installer/package outputs are local release artifacts, not source files.
*.exe
*.blockmap
*.nsis.7z
*.dmg
*.AppImage

