{
  "name": "kapanis",
  "version": "1.1.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "description": "Omni — Windows için tarayıcı, LibreChat, notlar, dosya paylaşımı, uzaktan erişim, medya, alarm ve güç yönetimini tek masaüstünde birleştiren kişisel çalışma alanı.",
  "author": "Omni contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "dev:ui": "vite",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "test": "npx tsx electron/TrustedDeviceStore.test.ts && npx tsx src/features/notes/lib/markdownParser.test.ts && npx tsx src/features/notes/lib/vaultEngine.test.ts && npx tsx src/features/music/providers/youtube/youtubeUrl.test.ts && npx tsx src/features/music/core/queue.test.ts && npx tsx src/features/music/core/persistence.test.ts && npx tsx src/features/music/core/musicStore.test.ts && npx tsx src/features/browser/browserState.test.ts",
    "test:browser": "npm run build && node electron/browser-smoke-runner.mjs",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/bricolage-grotesque": "^5.2.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@ghostery/adblocker-electron": "^2.18.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/supabase-js": "2.112.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "date-fns": "4.4.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^5.3.0",
    "koffi": "^3.1.6",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-day-picker": "10.0.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.kapanis.desktop",
    "productName": "Omni",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "app-icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/librechat-client",
        "to": "librechat-client",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Omni",
      "artifactName": "Omni-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "geniusprr",
        "repo": "Omni",
        "releaseType": "release"
      }
    ]
  }
}
